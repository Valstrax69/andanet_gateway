# Copia este archivo como .env EN LA EC2 y completa los CAMBIAME.
# Despues: chmod 600 .env   ·   nunca se sube a git (esta en .gitignore)

# Une los dos compose: desde esta carpeta, cualquier "docker compose ..." usa los dos
COMPOSE_FILE=compose.yaml:compose.nube.yaml

# --- Imagenes ---
OWNER=valstrax69
REGISTRY=ghcr.io
# Mientras el pipeline no publique :ep3, usa latest. Al entregar: TAG=ep3
TAG=latest

# --- HTTPS ---
# Tu IP elastica con guiones. Si la IP es 3.85.10.20 -> 3-85-10-20.sslip.io
DOMINIO=CAMBIAME-con-guiones.sslip.io
# En la EC2 el gateway no se publica al mundo: la unica entrada es Caddy por 443
GATEWAY_BIND=127.0.0.1

# --- Base de datos ---
# Genera una: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
# OJO: se fija la primera vez que se crea el volumen. Si ya levantaste con otra,
# baja todo con "docker compose down -v" antes de cambiarla.
POSTGRES_USER=anda
POSTGRES_PASSWORD=CAMBIAME
POSTGRES_DB=anda

# --- Clave de la API publica ---
# Genera una: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Varias separadas por coma. Una de estas va en el anexo C para el docente.
API_KEYS=CAMBIAME
LIMITE_POR_MINUTO=60

# --- SageMaker ---
MOTOR=sagemaker
ENDPOINT=ep3-chatbot
AWS_DEFAULT_REGION=us-east-1
SAGEMAKER_TIMEOUT=10

# --- NVIDIA (el LLM que redacta la respuesta) ---
# La key sale de build.nvidia.com; el modelo lo publico el docente en el foro.
NVIDIA_API_KEY=nvapi-CAMBIAME
NVIDIA_MODEL=CAMBIAME-el-del-foro
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT=20

# --- Clasificador ---
# Bajo este valor el asistente deriva a un ejecutivo en vez de responder.
UMBRAL_CONFIANZA=0.55
