# Copia este archivo como .env. Los valores por defecto ya funcionan para
# desarrollo (compose.dev.yaml). No pongas secretos reales aqui.

# Base de datos (credenciales de desarrollo, no son un secreto real)
POSTGRES_USER=anda
POSTGRES_PASSWORD=anda
POSTGRES_DB=anda

# --- Solo para el compose.yaml de la defensa (descarga de imagenes) ---
# Cuenta de GitHub donde se publicaron las imagenes, EN MINUSCULAS
# (GHCR siempre usa minusculas, aunque tu usuario tenga mayusculas).
OWNER=valstrax69
REGISTRY=ghcr.io
TAG=ep2

# Umbral de confianza del clasificador (0 a 1). Bajo este valor el asistente
# deriva a un ejecutivo en vez de responder. Subirlo acierta mas y responde
# menos; bajarlo responde mas y se equivoca mas.
UMBRAL_CONFIANZA=0.55
